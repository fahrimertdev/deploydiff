# Database
DATABASE_URL=postgresql://deploydiff:deploydiff@localhost:5432/deploydiff

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# S3-compatible Storage (MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=deploydiff-assets
S3_REGION=us-east-1

# Public URL for S3 assets (used in <img> tags)
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/deploydiff-assets
